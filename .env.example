# All variables are optional; the defaults below are used when unset.

# --- Limits (enforced server-side) -------------------------------------------
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=200
# How long finished results stay in server memory before being deleted.
JOB_RETENTION_MINUTES=30
# Hard wall-clock limit for one conversion.
CONVERSION_TIMEOUT_SECONDS=180
# Conversions processed in parallel per server process; extra jobs wait as "queued".
MAX_CONCURRENT_JOBS=2
# Per-client rate limit for POST /api/convert.
RATE_LIMIT_CONVERSIONS_PER_MINUTE=10

# --- OCR (Tesseract.js) ------------------------------------------------------
OCR_ENABLED=true
# Self-hosted language data (a directory or URL containing <lang>.traineddata.gz).
# Leave empty to let Tesseract.js download language data from its CDN on first use.
OCR_LANG_PATH=
# Where language data is cached. Defaults to a fresh temp directory.
OCR_CACHE_PATH=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
